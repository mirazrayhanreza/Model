rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Anyone can read public model photos and avatar images
    match /models/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.size < 10 * 1024 * 1024;
    }
    
    match /users/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.size < 5 * 1024 * 1024;
    }

    // Payment proof receipts and bank statements
    match /receipts/{allPaths=**} {
      allow read: if true;
      allow write: if true; // Allows backend or app to upload deposit and withdrawal proofs
    }

    // Real-time chat image attachments
    match /chats/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.size < 15 * 1024 * 1024;
    }

    // General fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.size < 20 * 1024 * 1024;
    }
  }
}
